# Maintainer: linux-live-wallpaper contributors
pkgname=linux-live-wallpaper
pkgver=0.1.0
pkgrel=1
pkgdesc="Interactive web wallpapers for Linux desktops"
arch=('x86_64' 'aarch64')
url="https://github.com/pskeffington/linux_live_wallpaper"
license=('MIT')
depends=('gtk4' 'webkitgtk-6.0' 'gtk4-layer-shell')
makedepends=('cargo')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/linux_live_wallpaper-${pkgver}"
  cargo build --release --locked
}

package() {
  cd "${srcdir}/linux_live_wallpaper-${pkgver}"
  install -Dm755 target/release/linux-live-wallpaper "${pkgdir}/usr/bin/linux-live-wallpaper"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
